include "/usr/share/nano/*.nanorc"
set atblanks
set constantshow
set historylog
set indicator
set linenumbers
set locking
set showcursor
set softwrap
set tabsize 4
set unix
bind M-F formatter main
bind M-S linter main

extendsyntax python formatter python-formatter
extendsyntax python linter python-linter
extendsyntax python tabgives "    "

extendsyntax sh linter shellcheck -f gcc
extendsyntax sh tabgives "  "

extendsyntax c linter cc -fanalyzer -Wall -Wextra -o /dev/null
extendsyntax c tabgives "    "

extendsyntax rust linter rust-linter
extendsyntax rust tabgives "    "

extendsyntax html tabgives "  "

extendsyntax css tabgives "    "
